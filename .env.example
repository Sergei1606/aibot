# Database
DATABASE_URL=postgresql+asyncpg://aibot:aibot@localhost:5432/aibotdb

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI API
OPENAI_API_KEY=sk-ваш_ключ_здесь

# Telegram API (получить на https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=ваш_api_hash_здесь

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=ваш_токен_бота_здесь

# Default channel for publishing
DEFAULT_TELEGRAM_CHANNEL=@your_channel

# ID администратора для уведомлений об ошибках
ADMIN_TELEGRAM_ID=ваш_id_в_telegram