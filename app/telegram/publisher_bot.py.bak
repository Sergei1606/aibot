from loguru import logger
from aiogram.exceptions import TelegramBadRequest, TelegramForbiddenError, TelegramRetryAfter

from app.telegram.client import get_bot
from app.config import settings


async def publish_to_channel(
    text: str,
    channel: str | None = None,
) -> int:
    """
    Публикует текст в Telegram-канал через aiogram.

    Args:
        text: Готовый текст поста.
        channel: username канала (@mychannel) или числовой ID.
                 Если не указан — берётся из настроек (TG_CHANNEL).

    Returns:
        ID опубликованного сообщения.

    Raises:
        ValueError: Если канал не задан или текст пустой.
        RuntimeError: При ошибках Telegram Bot API.
    """
    target = channel or settings.tg_channel

    if not target:
        raise ValueError(
            "Telegram-канал не задан. "
            "Укажите TG_CHANNEL в .env или передайте channel= в функцию."
        )

    if not text or not text.strip():
        raise ValueError("Текст поста не может быть пустым")

    bot = get_bot()

    try:
        logger.info(f"Publishing to {target}: {text[:60]}...")
        message = await bot.send_message(chat_id=target, text=text)
        logger.info(f"Published message ID={message.message_id} to {target}")
        return message.message_id

    except TelegramForbiddenError:
        raise RuntimeError(
            f"Нет прав для записи в канал {target}. "
            "Убедитесь, что бот является администратором канала "
            "и имеет право на публикацию сообщений."
        )
    except TelegramRetryAfter as e:
        raise RuntimeError(
            f"Telegram просит подождать {e.retry_after} секунд из-за rate limit"
        )
    except TelegramBadRequest as e:
        raise RuntimeError(f"Ошибка запроса к Telegram: {e}")
    except Exception as e:
        logger.error(f"Failed to publish to {target}: {e}")
        raise RuntimeError(f"Ошибка публикации: {e}")


async def test_connection(channel: str | None = None) -> bool:
    """
    Проверяет подключение к Telegram и доступ к каналу.
    Используется для диагностики.
    """
    target = channel or settings.tg_channel
    bot = get_bot()

    try:
        me = await bot.get_me()
        logger.info(f"Connected as bot: @{me.username}")

        if target:
            chat = await bot.get_chat(target)
            logger.info(f"Channel found: {chat.title} ({target})")

        return True
    except Exception as e:
        logger.error(f"Connection test failed: {e}")
        return False